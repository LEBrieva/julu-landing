---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import Concept from '@/components/Concept.astro';
import Storefront from '@/components/Storefront.astro';
import BehindBrand from '@/components/BehindBrand.astro';
import Lookbook from '@/components/Lookbook.astro';
import CreatorCTA from '@/components/CreatorCTA.astro';
import Footer from '@/components/Footer.astro';
import NewsletterPopup from '@/components/NewsletterPopup.astro';
---

<BaseLayout>
  <Header />
  <main id="contenido">
    <Hero />
    <Concept />
    <Storefront />
    <BehindBrand />
    <Lookbook />
    <CreatorCTA />
  </main>
  <Footer />
  <NewsletterPopup />
</BaseLayout>

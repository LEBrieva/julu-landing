---
import { Image } from 'astro:assets';
import { hero, brand } from '@/data/site';
import Button from './Button.astro';
import logoWhite from '@/assets/logo-white.png';

// El título mantiene su texto, pero la palabra final "JULU" se reemplaza
// por la lettering del logo. Ej: "Bienvenidos a JULU" -> "Bienvenidos a" + logo.
const titlePrefix = hero.title.replace(/\s*JULU\s*$/i, '');

// El tagline es un slogan corto: lo tratamos como tal (display bold, mayúsculas)
// y resaltamos la última palabra en color volt para darle punch.
const taglineWords = hero.subtitle.trim().split(/\s+/);
const taglineLead = taglineWords.slice(0, -1).join(' ');
const taglineAccent = taglineWords[taglineWords.length - 1];
---

<!--
  Hero SPLIT: copy a la izquierda sobre fondo oscuro + imagen vertical a la
  derecha. Pensado para una foto en formato retrato. Cuando exista una versión
  apaisada (wide) de la imagen, se puede volver al hero full-bleed con overlay.
-->
<section
  id="top"
  class="relative overflow-hidden bg-ink text-paper"
>
  <!-- Blob volt de fondo, detrás de la imagen, como acento de marca -->
  <div
    class="pointer-events-none absolute -right-24 top-1/2 -z-0 h-[42rem] w-[42rem] -translate-y-1/2 rounded-full bg-volt/15 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-5 pb-16 pt-28 sm:px-8 sm:pb-24 lg:min-h-[100svh] lg:grid-cols-2 lg:gap-12 lg:px-12 lg:py-0"
  >
    <!-- Columna de texto -->
    <div class="order-2 lg:order-1">
      <p
        data-reveal
        class="mb-5 text-sm font-semibold uppercase tracking-[0.25em] text-amber"
      >
        {hero.eyebrow}
      </p>
      <h1
        data-reveal
        data-reveal-delay="80"
        class="text-4xl uppercase leading-[0.95] sm:text-6xl lg:text-7xl"
      >
        {titlePrefix}
        <span class="sr-only">{brand.name}</span>
        <!--
          La palabra "JULU" usa la lettering del logo, en su propia línea como
          wordmark. Se pinta con el color `paper` del tema (no el blanco puro
          del PNG) vía máscara CSS, para que matchee el texto.
        -->
        <span
          aria-hidden="true"
          class="mt-1 block h-[2.25em] w-[3em] bg-paper"
          style={`-webkit-mask:url(${logoWhite.src}) left/contain no-repeat;mask:url(${logoWhite.src}) left/contain no-repeat;`}
        ></span>
      </h1>
      <p
        data-reveal
        data-reveal-delay="160"
        class="mt-6 font-display text-2xl font-bold uppercase tracking-wide text-paper sm:text-3xl"
      >
        {taglineLead}{' '}<span class="text-volt">{taglineAccent}</span>
      </p>
      <div
        data-reveal
        data-reveal-delay="240"
        class="mt-9 flex flex-wrap items-center gap-4"
      >
        <Button href={hero.ctaPrimary.href} variant="primary">
          {hero.ctaPrimary.label}
        </Button>
        <Button href={hero.ctaSecondary.href} variant="outline-dark">
          {hero.ctaSecondary.label}
        </Button>
      </div>
    </div>

    <!-- Columna de imagen (retrato) -->
    <div
      data-reveal
      data-reveal-delay="120"
      class="order-1 lg:order-2 lg:flex lg:h-[100svh] lg:items-center lg:justify-end"
    >
      <div
        class="hero-media relative mx-auto w-full max-w-md overflow-hidden rounded-card shadow-2xl shadow-black/40 ring-1 ring-paper/10 lg:mx-0 lg:max-w-none lg:h-[82svh] lg:w-auto"
      >
        <Image
          src={hero.image}
          alt={hero.imageAlt}
          widths={[480, 720, 1122]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>

  <!-- Indicador de scroll -->
  <div
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 text-paper/60 lg:block"
    aria-hidden="true"
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      class="animate-bounce"
    >
      <path d="M12 5v14M19 12l-7 7-7-7"></path>
    </svg>
  </div>
</section>

<script>
  import { scroll, animate } from 'motion';

  function initHeroParallax() {
    const prefersReduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    const media = document.querySelector('.hero-media');
    const hero = document.getElementById('top');
    if (prefersReduced || !media || !hero) return;

    // Float sutil de la imagen al hacer scroll (en vez del parallax full-bleed).
    scroll(
      animate(media, { y: [40, -40] }, { ease: 'linear' }),
      { target: hero, offset: ['start end', 'end start'] }
    );
  }

  document.addEventListener('astro:page-load', initHeroParallax);
</script>

---
import { newsletter } from '@/data/site';
import Button from './Button.astro';

const titleId = 'newsletter-title';
const descId = 'newsletter-desc';
---

{/* Popup de suscripción al newsletter.
    - Aparece al scrollear (config en site.ts: newsletter.scrollTrigger).
    - "No molestar": guarda en localStorage si se suscribió o lo cerró.
    - Accesible: role=dialog, foco atrapado, ESC para cerrar, foco devuelto. */}
<div
  id="newsletter-popup"
  class="pointer-events-none fixed inset-0 z-[60] hidden items-center justify-center p-4"
  data-error-text={newsletter.errorText}
  data-robot-error={newsletter.robotError}
  data-send-error={newsletter.sendError}
  data-scroll-trigger={newsletter.scrollTrigger}
  data-remind-days={newsletter.remindAfterDays}
>
  {/* Backdrop */}
  <div
    data-newsletter-backdrop
    class="absolute inset-0 bg-ink/70 opacity-0 backdrop-blur-sm transition-opacity duration-300 motion-reduce:transition-none"
    aria-hidden="true"
  >
  </div>

  {/* Panel */}
  <div
    data-newsletter-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby={titleId}
    aria-describedby={descId}
    class="relative w-full max-w-md translate-y-4 scale-95 overflow-hidden rounded-card bg-paper opacity-0 shadow-2xl ring-1 ring-ink/10 transition-all duration-300 ease-out motion-reduce:transition-none"
  >
    {/* Orejitas michi (decorativas) */}
    <span
      class="absolute -top-3 left-10 h-6 w-6 rotate-45 rounded-sm bg-volt"
      aria-hidden="true"></span>
    <span
      class="absolute -top-3 left-16 h-6 w-6 rotate-45 rounded-sm bg-volt"
      aria-hidden="true"></span>

    {/* Cerrar */}
    <button
      type="button"
      data-newsletter-close
      class="absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-pill text-ink/60 transition-colors hover:bg-ink/5 hover:text-ink"
      aria-label="Fechar"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    <div class="px-7 pb-7 pt-9 sm:px-9 sm:pb-9">
      {/* Estado: formulario */}
      <div data-newsletter-form-state>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-volt">
          {newsletter.eyebrow}
        </p>
        <h2 id={titleId} class="mt-3 text-3xl sm:text-4xl">
          {newsletter.title}
        </h2>
        <p id={descId} class="mt-3 text-base text-muted">
          {newsletter.text}
        </p>

        <form data-newsletter-form class="mt-6" novalidate>
          <label for="newsletter-email" class="sr-only">E-mail</label>
          <input
            id="newsletter-email"
            type="email"
            name="email"
            inputmode="email"
            autocomplete="email"
            required
            placeholder={newsletter.emailPlaceholder}
            class="w-full rounded-pill border-2 border-ink/15 bg-white px-5 py-3.5 text-base text-ink placeholder:text-muted/70 focus:border-volt focus:outline-none"
          />
          <p
            data-newsletter-error
            class="mt-2 hidden px-2 text-sm font-medium text-volt"
            role="alert"
          >
            {newsletter.errorText}
          </p>

          <div class="mt-4 flex justify-center">
            <div class="cf-turnstile" data-sitekey={newsletter.turnstileSiteKey} data-theme="light"></div>
          </div>

          <Button variant="primary" class="mt-4 w-full" ariaLabel={newsletter.submitLabel}>
            <span data-newsletter-submit-label>{newsletter.submitLabel}</span>
          </Button>

          <p class="mt-4 text-center text-xs leading-relaxed text-muted">
            {newsletter.consent}
          </p>
        </form>
      </div>

      {/* Estado: éxito */}
      <div data-newsletter-success-state class="hidden py-4 text-center">
        <div
          class="mx-auto flex h-16 w-16 items-center justify-center rounded-pill bg-volt/15 text-3xl"
          aria-hidden="true"
        >
          🐾
        </div>
        <h2 class="mt-5 text-3xl">{newsletter.successTitle}</h2>
        <p class="mt-3 text-base text-muted">{newsletter.successText}</p>
        <Button variant="outline" data-newsletter-close class="mt-6">
          Fechar
        </Button>
      </div>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'julu:newsletter';
  const DAY_MS = 24 * 60 * 60 * 1000;

  function initNewsletterPopup() {
    const root = document.getElementById('newsletter-popup');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const backdrop = root.querySelector<HTMLElement>('[data-newsletter-backdrop]');
    const panel = root.querySelector<HTMLElement>('[data-newsletter-panel]');
    const form = root.querySelector<HTMLFormElement>('[data-newsletter-form]');
    const input = root.querySelector<HTMLInputElement>('#newsletter-email');
    const errorEl = root.querySelector<HTMLElement>('[data-newsletter-error]');
    const submitLabel = root.querySelector<HTMLElement>('[data-newsletter-submit-label]');
    const formState = root.querySelector<HTMLElement>('[data-newsletter-form-state]');
    const successState = root.querySelector<HTMLElement>('[data-newsletter-success-state]');
    const closeButtons = root.querySelectorAll<HTMLButtonElement>('[data-newsletter-close]');

    if (!panel || !form || !input) return;

    const errorText = root.dataset.errorText || 'Ops, tenta de novo.';
    const robotError = root.dataset.robotError || errorText;
    const sendError = root.dataset.sendError || errorText;
    const widget = root.querySelector<HTMLElement>('.cf-turnstile');
    const scrollTrigger = parseFloat(root.dataset.scrollTrigger || '0.45');
    const remindDays = parseInt(root.dataset.remindDays || '7', 10);

    let isOpen = false;
    let lastFocused: HTMLElement | null = null;

    // ── Estado guardado (no molestar) ─────────────────────────
    function shouldShow(): boolean {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return true;
        const data = JSON.parse(raw) as { status?: string; at?: number };
        if (data.status === 'subscribed') return false;
        if (data.status === 'dismissed' && data.at) {
          return Date.now() - data.at > remindDays * DAY_MS;
        }
        return true;
      } catch {
        return true;
      }
    }

    function remember(status: 'subscribed' | 'dismissed') {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ status, at: Date.now() }));
      } catch {
        /* localStorage no disponible — sin persistencia, no rompemos */
      }
    }

    // ── Abrir / cerrar ────────────────────────────────────────
    function open() {
      if (isOpen) return;
      isOpen = true;
      lastFocused = document.activeElement as HTMLElement;
      root.classList.remove('hidden');
      root.classList.add('flex');
      root.style.pointerEvents = 'auto';
      // Forzar reflow para que la transición corra desde el estado inicial.
      void panel.offsetWidth;
      backdrop?.classList.remove('opacity-0');
      panel.classList.remove('opacity-0', 'translate-y-4', 'scale-95');
      input.focus();
      document.addEventListener('keydown', onKeydown);
    }

    function close() {
      if (!isOpen) return;
      isOpen = false;
      backdrop?.classList.add('opacity-0');
      panel.classList.add('opacity-0', 'translate-y-4', 'scale-95');
      root.style.pointerEvents = 'none';
      document.removeEventListener('keydown', onKeydown);
      window.setTimeout(() => {
        root.classList.add('hidden');
        root.classList.remove('flex');
      }, 300);
      lastFocused?.focus?.();
    }

    function dismiss() {
      remember('dismissed');
      close();
    }

    // ── Accesibilidad: ESC + trampa de foco ───────────────────
    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        dismiss();
        return;
      }
      if (e.key !== 'Tab') return;
      const focusables = panel.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
      );
      const visible = Array.from(focusables).filter((el) => el.offsetParent !== null);
      if (visible.length === 0) return;
      const first = visible[0];
      const last = visible[visible.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    // ── Envío ─────────────────────────────────────────────────
    function isValidEmail(value: string): boolean {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
    }

    function showError(message: string) {
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.remove('hidden');
      }
      input.setAttribute('aria-invalid', 'true');
      input.focus();
    }

    function showSuccess() {
      formState?.classList.add('hidden');
      successState?.classList.remove('hidden');
    }

    function resetCaptcha() {
      try {
        (window as any).turnstile?.reset(widget);
      } catch {
        /* noop */
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl?.classList.add('hidden');
      input.removeAttribute('aria-invalid');

      const email = input.value.trim();
      if (!isValidEmail(email)) {
        showError(errorText);
        return;
      }

      const token = new FormData(form).get('cf-turnstile-response')?.toString() || '';
      if (!token) {
        showError(robotError);
        return;
      }

      const originalLabel = submitLabel?.textContent ?? '';
      if (submitLabel) submitLabel.textContent = 'Enviando…';

      try {
        // /api/subscribe verifica el Turnstile y reenvía a Brevo server-side.
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, token }),
        });
        const data = await res.json().catch(() => ({ ok: res.ok }));
        if (!res.ok || !data.ok) {
          resetCaptcha();
          if (submitLabel) submitLabel.textContent = originalLabel;
          if (data?.error === 'captcha') showError(robotError);
          else if (data?.error === 'email') showError(errorText);
          else showError(sendError);
          return;
        }
        remember('subscribed');
        showSuccess();
      } catch {
        resetCaptcha();
        if (submitLabel) submitLabel.textContent = originalLabel;
        showError(sendError);
      }
    });

    // ── Cierres ───────────────────────────────────────────────
    closeButtons.forEach((btn) => btn.addEventListener('click', dismiss));
    backdrop?.addEventListener('click', dismiss);

    // ── Trigger por scroll ────────────────────────────────────
    if (!shouldShow()) return;

    function onScroll() {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
      if (progress >= scrollTrigger) {
        window.removeEventListener('scroll', onScroll);
        open();
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); // por si ya carga scrolleado
  }

  document.addEventListener('astro:page-load', initNewsletterPopup);
</script>

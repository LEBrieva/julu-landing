---
import { Image } from 'astro:assets';
import type { Person } from '@/data/site';

interface Props {
  person: Person;
}

const { person } = Astro.props;
---

<article class="group text-center">
  <div class="relative mx-auto w-full overflow-hidden rounded-card">
    <Image
      src={person.image}
      alt={person.isCat ? `${person.name}, gato de la familia JULU` : person.name}
      widths={[240, 360, 480]}
      sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw"
      loading="lazy"
      class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    {
      person.isCat && (
        <span
          class="absolute right-3 top-3 rounded-pill bg-volt px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-ink"
          aria-hidden="true"
        >
          🐾 michi
        </span>
      )
    }
  </div>
  <h3 class="mt-4 font-display text-xl font-bold">{person.name}</h3>
  <p class="text-sm font-semibold uppercase tracking-wide text-volt">
    {person.role}
  </p>
  <p class="mt-2 text-sm leading-relaxed text-muted-dark">{person.bio}</p>
</article>
